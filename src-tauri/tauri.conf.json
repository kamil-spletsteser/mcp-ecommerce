{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "E-commerce MCP",
  "version": "0.1.0",
  "identifier": "com.lampartoms.ecommerce-mcp",
  "mainBinaryName": "ecommerce-mcp",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "E-commerce MCP",
        "width": 960,
        "height": 760,
        "minWidth": 640,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "Lokalny serwer MCP dla Twojego e-commerce",
    "publisher": "Lampartoms",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": { "minimumSystemVersion": "11.0" },
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
